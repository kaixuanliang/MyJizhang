<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/page_bg"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <!-- 汇总卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:layout_marginHorizontal="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/label_count"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="笔数" android:textSize="12sp" android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/text_count"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="0 笔" android:textSize="16sp"
                android:textStyle="bold" android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/label_outstanding"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="未还金额" android:textSize="12sp" android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/text_outstanding"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="0.00" android:textSize="16sp"
                android:textStyle="bold" android:textColor="@color/expense_red" />
        </LinearLayout>
    </LinearLayout>

    <!-- 空态提示：新用户进来至少知道去哪儿加、怎么还款 -->
    <TextView
        android:id="@+id/text_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="32dp"
        android:text="还没有记录\n点右上角「＋」添加，记完可以在条目右侧点「记录还款」"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
