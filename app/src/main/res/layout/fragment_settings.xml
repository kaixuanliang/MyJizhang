<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 当前账本卡 -->
        <LinearLayout
            android:id="@+id/row_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="20sp"
                android:text="📚"
                android:background="@drawable/bg_icon_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账本管理"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/text_current_book"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="个人账本"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="22sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 数据卡片组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/row_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:textSize="20sp"
                    android:text="📤" android:background="@drawable/bg_icon_green" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="账单导出" android:textSize="15sp" android:textColor="@color/text_primary" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="导出 Excel（兼容一飞记账格式）"
                        android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="72dp" android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/row_import_wizard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:textSize="20sp"
                    android:text="🧭" android:background="@drawable/bg_icon_blue" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="导入迁移向导" android:textSize="15sp" android:textColor="@color/text_primary" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="填真实余额、整理分类，把旧账彻底搬过来（推荐）"
                        android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="72dp" android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/row_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:textSize="20sp"
                    android:text="📥" android:background="@drawable/bg_icon_orange" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="账单导入" android:textSize="15sp" android:textColor="@color/text_primary" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="支持一飞记账导出的 xlsx 账单"
                        android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="72dp" android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/row_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:textSize="20sp"
                    android:text="☁️" android:background="@drawable/bg_icon_blue" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="同步" android:textSize="15sp" android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/text_sync_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="GitHub 仓库加密备份"
                        android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="72dp" android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/row_adjust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:textSize="20sp"
                    android:text="🧾" android:background="@drawable/bg_icon_blue" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="对账记录" android:textSize="15sp" android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/text_adjust_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="改余额 / 删账单 / 还借款的调整流水"
                        android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:id="@+id/row_book_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:textSize="20sp"
                    android:text="✏️" android:background="@drawable/bg_icon_purple" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:text="修改账本信息"
                    android:textSize="15sp" android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="72dp" android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/row_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:textSize="20sp"
                    android:text="ℹ️" android:background="@drawable/bg_icon_green" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:text="关于"
                    android:textSize="15sp" android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
