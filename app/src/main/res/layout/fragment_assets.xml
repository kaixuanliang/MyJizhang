<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/page_bg">

        <!-- 标题栏：资产管理 + 添加 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="资产管理"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btn_add_asset"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="22sp"
                android:text="＋"
                android:textColor="@color/text_primary"
                android:contentDescription="添加资产" />
        </LinearLayout>

        <!-- 蓝色渐变净资产卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_asset_header"
            android:layout_marginHorizontal="12dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="净资产"
                android:textSize="13sp"
                android:textColor="#DDEFFF" />

            <TextView
                android:id="@+id/text_net_asset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="0.00"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="可支配" android:textSize="12sp" android:textColor="#DDEFFF" />
                    <TextView android:id="@+id/text_cash_asset" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="0.00" android:textSize="15sp"
                        android:maxLines="1"
                        android:textStyle="bold" android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="投资" android:textSize="12sp" android:textColor="#DDEFFF" />
                    <TextView android:id="@+id/text_invest_asset" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="0.00" android:textSize="15sp"
                        android:maxLines="1"
                        android:textStyle="bold" android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="应收" android:textSize="12sp" android:textColor="#DDEFFF" />
                    <TextView android:id="@+id/text_receivable_asset" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="0.00" android:textSize="15sp"
                        android:maxLines="1"
                        android:textStyle="bold" android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="负债" android:textSize="12sp" android:textColor="#DDEFFF" />
                    <TextView android:id="@+id/text_total_credit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="0.00" android:textSize="15sp"
                        android:maxLines="1"
                        android:textStyle="bold" android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="净资产 = 可支配 + 投资 + 应收借出 − 负债（含未还借入）"
                android:textSize="11sp"
                android:textColor="#B8D4EE" />
        </LinearLayout>

        <!-- 总借入 / 总借出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/card_borrow_in"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="总借入" android:textSize="13sp" android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/text_borrow_in"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="0.00" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_borrow_out"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:layout_marginStart="10dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="总借出" android:textSize="13sp" android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/text_borrow_out"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="0.00" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_assets"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>
</FrameLayout>
