<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 整体缩到 0.78 并居中：自适应图标安全区内，四周留出足够蓝底 -->
    <!-- translateY=3 补偿卡片向上探出造成的视觉偏上，使上下留白对等 -->
    <group
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:pivotX="54"
        android:pivotY="54"
        android:translateY="3">

        <!-- 浅色卡片（左，向左倾） -->
        <group
            android:rotation="-9"
            android:pivotX="41"
            android:pivotY="32">
            <path
                android:fillColor="#EAF4FD"
                android:pathData="M33,21 H49 A4,4 0 0 1 53,25 V39 A4,4 0 0 1 49,43 H33 A4,4 0 0 1 29,39 V25 A4,4 0 0 1 33,21 Z" />
        </group>

        <!-- 金色卡片（右，向右倾，压在浅色卡之上） -->
        <group
            android:rotation="9"
            android:pivotX="58"
            android:pivotY="32">
            <path
                android:fillColor="#EF9F27"
                android:pathData="M49,19 H67 A4,4 0 0 1 71,23 V38 A4,4 0 0 1 67,42 H49 A4,4 0 0 1 45,38 V23 A4,4 0 0 1 49,19 Z" />
        </group>

        <!-- 钱包主体 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M24,38 H84 V71 A11,11 0 0 1 73,82 H35 A11,11 0 0 1 24,71 Z" />

        <!-- 钱包口（浅蓝唇边，盖住卡片下缘） -->
        <path
            android:fillColor="#CFE3F7"
            android:pathData="M35,38 H73 A11,11 0 0 1 84,49 H24 A11,11 0 0 1 35,38 Z" />

        <!-- 人民币压印 -->
        <path
            android:strokeColor="#85B7EB"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M39.5,58 L44,64 L48.5,58 M44,64 V72.5 M40.2,66.8 H47.8 M40.2,69.6 H47.8" />

        <!-- 金色锁扣 -->
        <path
            android:fillColor="#EF9F27"
            android:pathData="M66.5,66 A5.5,5.5 0 1 1 77.5,66 A5.5,5.5 0 1 1 66.5,66 Z" />
    </group>
</vector>
